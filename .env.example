# Copy to .env and fill in. Never commit .env.

# --- Helpdesk (from the Nordavo email) ---
HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_API_KEY=nrd_round_xxxxxxxx
# The email address you applied with. Always the same one: it identifies your account.
CANDIDATE_EMAIL=you@example.com
CANDIDATE_NAME=

# --- LLM: any OpenAI-compatible API ---
# Examples (pick one):
#   OpenAI:      LLM_BASE_URL=                                   AGENT_MODEL=gpt-4o-mini
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1    AGENT_MODEL=openai/gpt-oss-120b  LLM_REASONING_EFFORT=low
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AGENT_MODEL=gemini-2.5-flash
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1      AGENT_MODEL=<model id>
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1          AGENT_MODEL=qwen2.5:7b-instruct  LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
AGENT_MODEL=
# Model for the reply checker; defaults to AGENT_MODEL.
JUDGE_MODEL=
# "schema" = strict JSON schema output; use "object" if the provider rejects json_schema.
LLM_JSON_MODE=schema
# For reasoning models (gpt-oss, o-series): low | medium | high. Leave empty otherwise.
LLM_REASONING_EFFORT=
# Your provider's price in USD per 1M tokens, for the cost report (0 for free tiers).
LLM_PRICE_IN_PER_1M=0
LLM_PRICE_OUT_PER_1M=0

# Replies below this self-reported confidence go to a human instead.
MIN_REPLY_CONFIDENCE=0.75
