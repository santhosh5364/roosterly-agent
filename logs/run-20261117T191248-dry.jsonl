{"ts": "2026-11-17T13:43:48+00:00", "run": "20261117T191248", "ticket": "T005", "outcome": "dry_run", "action": "reply", "language": "nl", "category": "question", "priority": "P4", "confidence": 0.99, "faq_ids": ["F02"], "model_action": "reply", "hard_rules": [], "escalated_because": [], "reply_en": "Hi Anouk,\n\nYou can add a new employee via Team → Add employee. Fill in the name, email address and contract hours and click Invite. The employee will receive an email to install the app.\n\nRegards,\nTeam Roosterly", "redacted": [], "seconds": 30.29}
