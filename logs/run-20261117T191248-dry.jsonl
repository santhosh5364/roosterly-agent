{"ts": "2026-11-17T13:49:16+00:00", "run": "20261117T191248", "ticket": "T026", "outcome": "dry_run", "action": "reply", "language": "nl", "category": "question", "priority": "P4", "confidence": 0.98, "faq_ids": ["F09"], "model_action": "reply", "hard_rules": [], "escalated_because": [], "reply_en": "Hi,\n\nOur data is stored in the EU, specifically in Frankfurt, Germany. You can download the data processing agreement via Settings → Legal (Instellingen → Juridisch).\n\nKind regards,\nTeam Roosterly", "redacted": [], "seconds": 6.93}
