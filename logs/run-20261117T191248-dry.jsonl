{"ts": "2026-11-17T13:48:55+00:00", "run": "20261117T191248", "ticket": "T023", "outcome": "dry_run", "action": "reply", "language": "nl", "category": "billing", "priority": "P3", "confidence": 0.99, "faq_ids": ["F05"], "model_action": "reply", "hard_rules": [], "escalated_because": [], "reply_en": "Hi,\n\nYou can upgrade your subscription via Settings → Subscription. Choose the Plus plan there; the new price will be applied from the next invoice.\n\nTeam Roosterly", "redacted": [], "seconds": 17.76}
