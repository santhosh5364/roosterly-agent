{"ts": "2026-11-17T13:42:54+00:00", "run": "20261117T191248", "ticket": "T001", "outcome": "dry_run", "action": "reply", "language": "nl", "category": "question", "priority": "P2", "confidence": 0.99, "faq_ids": ["F01"], "model_action": "reply", "hard_rules": [], "escalated_because": [], "reply_en": "Hi Marloes,\n\nYou can reset your password via the login page. Go to app.roosterly.nl/login, click on \"Wachtwoord vergeten\" and fill in your email address. You will receive a reset link that is valid for 60 minutes. Also check your spam folder if you see nothing within 10 minutes.\n\nTeam Roosterly", "redacted": [], "seconds": 3.57}
